{
  "language": "zh-CN",
  "duration_sec": 60,
  "captions": [
    {
      "start_sec": 0.3,
      "end_sec": 4.48,
      "text": "周四开项目会，你得翻五份旧记录，"
    },
    {
      "start_sec": 4.63,
      "end_sec": 9.61,
      "text": "找出上次定了什么、还有哪件事没人跟进。"
    },
    {
      "start_sec": 9.76,
      "end_sec": 13.41,
      "text": "以前要一份份打开，逐条复制，"
    },
    {
      "start_sec": 13.56,
      "end_sec": 16.41,
      "text": "再手动对照，很容易漏。"
    },
    {
      "start_sec": 18.11,
      "end_sec": 22.56,
      "text": "现在把五份记录一起交给示例笔记 AI，"
    },
    {
      "start_sec": 22.71,
      "end_sec": 26.09,
      "text": "它先整理出一页会前摘要："
    },
    {
      "start_sec": 26.24,
      "end_sec": 30.69,
      "text": "已定的决定、没做完的任务和负责人。"
    },
    {
      "start_sec": 30.84,
      "end_sec": 37.42,
      "text": "比如供应商报价这一条，它标出还没回复，负责人是小林。"
    },
    {
      "start_sec": 39.12,
      "end_sec": 42.5,
      "text": "但这只是草稿。发出去之前，"
    },
    {
      "start_sec": 42.65,
      "end_sec": 47.1,
      "text": "你要回到原记录，核对日期和负责人。"
    },
    {
      "start_sec": 47.25,
      "end_sec": 53.3,
      "text": "如果你也常开周会，先拿一份不敏感的记录试一次，"
    },
    {
      "start_sec": 53.45,
      "end_sec": 56.03,
      "text": "看看它有没有漏项。"
    }
  ],
  "transitions": [
    {
      "start_sec": 16.56,
      "end_sec": 17.96,
      "label": "把同样五份记录交给 AI",
      "readable": true
    },
    {
      "start_sec": 37.57,
      "end_sec": 38.97,
      "label": "最后一步还是你",
      "readable": true
    }
  ]
}
